# Optional: absolute path to SQLite file (must be on a writable volume)
# CRICKET_DB_PATH=/var/data/cricket.db

# Optional: directory for cricket.db (default: ./data locally, /tmp/tournament-manager on Vercel)
# CRICKET_DB_DIR=/var/data

# Optional: copy this file into CRICKET_DB_PATH on first start (read-only seed)
# CRICKET_DB_SEED_PATH=/app/data/cricket.db
